generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id
  email           String         @unique
  name            String?
  companyName     String?
  avatarUrl       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  parties         Party[]
  products        Product[]
  priceLists      PriceList[]
  salesBills      SalesBill[]
  purchaseBills   PurchaseBill[]
  transactions    Transaction[]
  expenses        Expense[]
  damages         Damage[]
  salesItems      SalesItem[]
  purchaseItems   PurchaseItem[]
}

model Party {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        String
  balance     Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  priceLists      PriceList[]
  salesBills      SalesBill[]
  purchaseBills   PurchaseBill[]
  suppliedProducts Product[]      @relation("SupplierToProduct")
  damages         Damage[]
}

model Product {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        String
  variant     String
  company     String
  stock       Int      @default(0)
  cartonSize  Int      @default(1)
  basePrice   Float
  supplierId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplier        Party?          @relation("SupplierToProduct", fields: [supplierId], references: [id])
  priceLists      PriceList[]
  salesItems      SalesItem[]
  purchaseItems   PurchaseItem[]
  damages         Damage[]
}

model PriceList {
  id        String   @id @default(cuid())
  userId    String
  partyId   String
  productId String
  price     Float

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  party   Party   @relation(fields: [partyId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([partyId, productId])
}

model SalesBill {
  id        String   @id @default(cuid())
  userId    String
  partyId   String
  total     Float
  discount  Float    @default(0)
  date      DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  party   Party       @relation(fields: [partyId], references: [id])
  items   SalesItem[]
  damages Damage[]
}

model SalesItem {
  id          String   @id @default(cuid())
  userId      String
  salesBillId String
  productId   String
  quantity    Int
  price       Float
  costPrice   Float

  salesBill SalesBill @relation(fields: [salesBillId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PurchaseBill {
  id        String   @id @default(cuid())
  userId    String
  partyId   String
  total     Float
  date      DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  party   Party         @relation(fields: [partyId], references: [id])
  items   PurchaseItem[]
}

model PurchaseItem {
  id             String   @id @default(cuid())
  userId         String
  purchaseBillId String
  productId      String
  quantity       Int
  price          Float

  purchaseBill PurchaseBill @relation(fields: [purchaseBillId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String?
  partyId   String?
  amount    Float
  type      String
  source    String?
  purpose   String
  date      DateTime @default(now())

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  party Party? @relation(fields: [partyId], references: [id])
}

model Expense {
  id        String   @id @default(cuid())
  userId    String
  name      String
  amount    Float
  date      DateTime @default(now())
  source    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Damage {
  id              String      @id @default(cuid())
  userId          String
  partyId         String
  productId       String
  quantity        Int
  amount          Float
  description     String?
  status          String      @default("PENDING")
  createdAt       DateTime    @default(now())
  appliedToBillId String?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  party     Party      @relation(fields: [partyId], references: [id])
  product   Product    @relation(fields: [productId], references: [id])
  salesBill SalesBill? @relation(fields: [appliedToBillId], references: [id])
}

model CashFlow {
  id        String   @id @default(cuid())
  type      String
  balance   Float    @default(0)
  updatedAt DateTime @updatedAt
}